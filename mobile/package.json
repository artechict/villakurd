{
  "name": "@villakurd/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "VillaKurd Mobile App - React Native + Expo + TypeScript",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "detox test -c ios.sim.release",
    "clean": "rm -rf .expo dist coverage .turbo node_modules/.cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@gorhom/bottom-sheet": "^4.5.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-community/datetimepicker": "^8.0.0",
    "@react-native-community/netinfo": "^11.0.0",
    "@react-native-masked-view/masked-view": "^0.3.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "date-fns-jalali": "^3.6.0",
    "expo": "^50.0.0",
    "expo-constants": "^15.4.0",
    "expo-device": "^5.9.0",
    "expo-file-system": "^16.0.0",
    "expo-font": "^11.10.0",
    "expo-haptics": "^12.8.0",
    "expo-image": "^1.10.0",
    "expo-image-picker": "^14.7.0",
    "expo-linear-gradient": "^12.7.0",
    "expo-linking": "^6.2.0",
    "expo-location": "^16.5.0",
    "expo-notifications": "^27.6.0",
    "expo-router": "^3.4.0",
    "expo-secure-store": "^12.8.0",
    "expo-splash-screen": "^0.26.0",
    "expo-status-bar": "^1.11.0",
    "expo-system-ui": "^2.9.0",
    "expo-web-browser": "^12.8.0",
    "lucide-react-native": "^0.358.0",
    "nativewind": "^4.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.51.0",
    "react-native": "0.73.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-maps": "^1.10.0",
    "react-native-reanimated": "^3.8.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.5.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@testing-library/jest-native": "^5.4.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.0.0",
    "detox": "^20.10.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^6.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.0",
    "prettier": "^3.2.0",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "expo": {
    "install": {
      "exclude": ["detox", "jest", "jest-expo", "react-test-renderer"]
    }
  }
}